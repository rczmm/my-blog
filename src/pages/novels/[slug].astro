---
import AetherLayout from '../../layouts/AetherLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const novels = await getCollection('novels');
  return novels.map((novel) => ({
    params: { slug: novel.slug },
    props: { novel },
  }));
}

const { novel } = Astro.props;
const { Content } = await novel.render();

// 格式化日期的函数
function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<AetherLayout title={novel.data.title}>
  <div class="novel-container">
    <div class="novel-header glass-card">
      <nav class="novel-breadcrumb">
        <a href="/novels" class="breadcrumb-link">书架</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">{novel.data.title}</span>
      </nav>

      <div class="novel-main-info">
        <h1 class="novel-title">{novel.data.title}</h1>
        <div class="novel-meta">
          <span class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            作者：{novel.data.author}
          </span>
          <span class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            发布：{formatDate(novel.data.pubDate)}
          </span>
        </div>
        <div class="novel-tags">
          {novel.data.tags?.map(tag => (
            <span class="novel-tag">#{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <article class="novel-content glass-card">
      <div class="reading-interface">
        <Content />
      </div>
    </article>

    <div class="novel-footer">
      <a href="/novels" class="back-to-shelf glass-card">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"></path><polyline points="12 19 5 12 12 5"></polyline></svg>
        返回书架
      </a>
    </div>
  </div>

  <style is:global>
    /* 针对小说内容的特殊样式 */
    .reading-interface h1 {
      font-size: 1.8rem;
      color: var(--color-primary-start);
      margin-top: 40px;
      margin-bottom: 30px;
      text-align: center;
      border-bottom: 1px solid var(--color-primary-start-alpha);
      padding-bottom: 15px;
      letter-spacing: 4px;
    }

    .reading-interface p {
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 1.5rem;
      color: var(--color-text);
      text-indent: 2em;
      letter-spacing: 1px;
    }

    .reading-interface blockquote {
      border-left: 4px solid var(--color-primary-start);
      padding-left: 20px;
      font-style: italic;
      color: var(--color-neutral);
      background: rgba(255, 255, 255, 0.02);
      padding: 15px 25px;
      margin: 20px 0;
      border-radius: 4px;
    }
  </style>

  <style>
    .novel-container {
      max-width: 900px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .novel-header {
      padding: 30px;
      margin-bottom: 30px;
      border-top: 4px solid var(--color-primary-start);
    }

    .novel-breadcrumb {
      display: flex;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      margin-bottom: 25px;
      color: var(--color-neutral);
    }

    .breadcrumb-link {
      color: var(--color-primary-start);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .breadcrumb-link:hover {
      color: var(--color-primary-end);
      text-decoration: underline;
    }

    .breadcrumb-separator {
      color: var(--color-neutral-light);
    }

    .novel-title {
      font-size: 2.2rem;
      color: var(--color-text);
      margin-bottom: 15px;
      letter-spacing: 2px;
    }

    .novel-meta {
      display: flex;
      gap: 20px;
      font-size: 0.9rem;
      color: var(--color-neutral);
      margin-bottom: 20px;
      font-family: var(--font-mono);
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .novel-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .novel-tag {
      font-size: 0.8rem;
      color: var(--color-primary-start);
      font-family: var(--font-mono);
      padding: 3px 10px;
      background: var(--color-primary-start-alpha);
      border-radius: 4px;
      border: 1px solid var(--color-primary-start-alpha);
    }

    .novel-content {
      padding: 50px;
      min-height: 500px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .novel-footer {
      margin-top: 40px;
      display: flex;
      justify-content: center;
    }

    .back-to-shelf {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 25px;
      color: var(--color-text);
      text-decoration: none;
      font-family: var(--font-mono);
      transition: all 0.3s ease;
      border: 1px solid var(--color-primary-start-alpha);
    }

    .back-to-shelf:hover {
      transform: scale(1.05);
      background: var(--color-primary-start-alpha);
      box-shadow: 0 0 20px var(--color-primary-start-alpha);
    }

    @media (max-width: 768px) {
      .novel-header {
        padding: 20px;
      }
      .novel-title {
        font-size: 1.8rem;
      }
      .novel-content {
        padding: 25px;
      }
      .novel-meta {
        flex-direction: column;
        gap: 10px;
      }
    }
  </style>
</AetherLayout>
