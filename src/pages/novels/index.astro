---
import AetherLayout from '../../layouts/AetherLayout.astro';
import { getCollection } from 'astro:content';

// 获取所有小说
const allNovels = await getCollection('novels');

// 按发布日期降序排序
allNovels.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 格式化日期的函数
function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<AetherLayout title="书架">
  <section class="bookshelf-section">
    <div class="section-header">
      <h2>我的书架 <span class="blinking-cursor">_</span></h2>
      <p class="section-desc">数据存档：小说模块</p>
    </div>

    <div class="bookshelf-grid">
      {allNovels.length === 0 ? (
        <div class="no-books glass-card">
          <p>书架空空如也，暂无数据存档。</p>
        </div>
      ) : (
        allNovels.map((novel) => (
          <article class="book-card glass-card">
            <a href={`/novels/${novel.slug}`} class="card-link-overlay" aria-label={`阅读 ${novel.data.title}`}></a>
            
            <div class="book-cover-container">
              {novel.data.cover ? (
                <img src={novel.data.cover} alt={novel.data.title} class="book-cover" />
              ) : (
                <div class="book-cover-placeholder">
                  <span>{novel.data.title[0]}</span>
                </div>
              )}
              <div class="book-badge">NOVEL</div>
            </div>

            <div class="book-info">
              <h3 class="book-title">{novel.data.title}</h3>
              <div class="book-meta">
                <span class="book-author">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  {novel.data.author}
                </span>
                <span class="book-date">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  {formatDate(novel.data.pubDate)}
                </span>
              </div>
              <p class="book-description">{novel.data.description}</p>
              <div class="book-tags">
                {novel.data.tags?.map(tag => (
                  <span class="book-tag">#{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      )}
    </div>
  </section>

  <style>
    .bookshelf-section {
      padding: 40px 20px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-header {
      margin-bottom: 40px;
      border-left: 4px solid var(--color-primary-start);
      padding-left: 20px;
    }

    .section-header h2 {
      font-size: 2.5rem;
      color: var(--color-text);
      margin-bottom: 8px;
      letter-spacing: 2px;
    }

    .section-desc {
      color: var(--color-neutral);
      font-family: var(--font-mono);
      font-size: 0.9rem;
    }

    .bookshelf-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 30px;
    }

    .book-card {
      position: relative;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
      height: 100%;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .book-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px var(--color-primary-start-alpha);
      border-color: var(--color-primary-start-alpha);
    }

    .card-link-overlay {
      position: absolute;
      inset: 0;
      z-index: 10;
    }

    .book-cover-container {
      position: relative;
      width: 100%;
      aspect-ratio: 2/3;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.2);
    }

    .book-cover {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .book-card:hover .book-cover {
      transform: scale(1.1);
    }

    .book-cover-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--color-primary-start-alpha), var(--color-primary-end-alpha));
      font-size: 4rem;
      font-weight: bold;
      color: var(--color-text);
      text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
    }

    .book-badge {
      position: absolute;
      top: 15px;
      right: 15px;
      background: var(--color-primary-start);
      color: white;
      font-family: var(--font-mono);
      font-size: 10px;
      padding: 4px 10px;
      border-radius: 4px;
      letter-spacing: 1px;
      z-index: 2;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .book-info {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .book-title {
      font-size: 1.4rem;
      color: var(--color-text);
      margin-bottom: 12px;
      line-height: 1.2;
    }

    .book-meta {
      display: flex;
      gap: 15px;
      font-size: 0.8rem;
      color: var(--color-neutral);
      margin-bottom: 15px;
      font-family: var(--font-mono);
    }

    .book-meta span {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .book-description {
      font-size: 0.9rem;
      color: var(--color-neutral-light);
      line-height: 1.6;
      margin-bottom: 20px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .book-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: auto;
    }

    .book-tag {
      font-size: 0.75rem;
      color: var(--color-primary-start);
      font-family: var(--font-mono);
      padding: 2px 8px;
      background: var(--color-primary-start-alpha);
      border-radius: 4px;
      border: 1px solid var(--color-primary-start-alpha);
    }

    .blinking-cursor {
      display: inline-block;
      width: 10px;
      animation: blink 1s infinite;
      color: var(--color-primary-start);
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    .no-books {
      grid-column: 1 / -1;
      padding: 60px;
      text-align: center;
      color: var(--color-neutral);
      font-family: var(--font-mono);
    }

    @media (max-width: 768px) {
      .section-header h2 {
        font-size: 2rem;
      }
      .bookshelf-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</AetherLayout>
